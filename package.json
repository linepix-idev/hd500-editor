{
  "name": "hd500-editor",
  "version": "0.2.10",
  "description": "Free, open editor for the Line 6 POD HD500 (Linux, Windows, macOS)",
  "main": "app/main.cjs",
  "scripts": {
    "start": "node app/server.mjs",
    "gen-catalog": "python3 tools/gen-catalog.py",
    "app": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "test": "node tools/check-fx-details.mjs && node tools/i18n/check-coverage.mjs && node --test tests/core.test.mjs tests/security.test.mjs tests/live-edit.test.mjs tests/mcp.test.mjs tests/limits.test.mjs tests/fx-details.test.mjs tests/i18n-coverage.test.mjs tests/i18n-runtime.test.mjs",
    "test:live-demo": "HD500_DEMO=1 PORT=5231 node tests/live-edit.test.mjs tests/mcp.test.mjs tests/limits.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs /tmp",
    "test:ui-i18n": "HD500_DEMO=1 PORT=5231 node tests/ui-i18n.mjs",
    "test:live": "node tests/api-live.mjs && node tests/ui-interact.mjs"
  },
  "author": {
    "name": "Linepix",
    "email": "linepix.idev@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "usb": "^2.14.0"
  },
  "private": true,
  "build": {
    "appId": "org.hd500edit.app",
    "productName": "HD500 Editor",
    "copyright": "MIT — não afiliado à Line 6",
    "files": [
      "app/**",
      "core/**",
      "catalog/**",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/usb/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "synopsis": "Editor livre para o Line 6 POD HD500",
      "extraResources": [
        {
          "from": "99-line6-hd500.rules",
          "to": "99-line6-hd500.rules"
        }
      ],
      "artifactName": "HD500-Editor-${version}.${ext}"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.sh"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/win/zadig.exe",
          "to": "zadig.exe"
        }
      ],
      "artifactName": "HD500-Editor-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "HD500-Editor-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "HD500-Editor-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    }
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.13.0"
  },
  "homepage": "https://github.com/linepix-idev/hd500-editor#readme",
  "keywords": [
    "line6",
    "pod-hd500",
    "guitar",
    "editor",
    "usb",
    "reverse-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linepix-idev/hd500-editor.git"
  },
  "bugs": {
    "url": "https://github.com/linepix-idev/hd500-editor/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
